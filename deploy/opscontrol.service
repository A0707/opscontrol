[Unit]
Description=OpsControl Infrastructure Operations Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opscontrol
Group=opscontrol
WorkingDirectory=/opt/opscontrol
EnvironmentFile=-/etc/opscontrol/opscontrol.env
ExecStart=/opt/opscontrol/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
