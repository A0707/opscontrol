# Copy this file to .env only if your process manager loads environment files.
# Never commit the resulting .env file.
OPSCONTROL_INVENTORY=hosts.yaml
OPSCONTROL_DB=data/state.sqlite3
OPSCONTROL_AUTO_INTERVAL=0
COCKPIT_SSH_USER=opscontrol
COCKPIT_SSH_KEY=~/.ssh/id_ed25519
COCKPIT_WORKERS=4

# Store authentication values outside Git. The application configuration only
# refers to these variable names.
OPSCONTROL_PROXMOX_AUTH=
OPSCONTROL_WAZUH_AUTH=
OPSCONTROL_ZABBIX_AUTH=
OPSCONTROL_ELASTIC_AUTH=
OPSCONTROL_BACULA_AUTH=
